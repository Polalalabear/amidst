  "contract_delta_v1_0_to_v1_1": [
    {
      "section": "§3.11 rgb_index.json",
      "v1_0_2643771": "records 欄位 {camera_id, frame_index, timestamp_s, rgb_ref, file_sha256}，另有 expected grid 與 missing 紀錄（未定結構）",
      "v1_1_0e51c53": "分成 records[] 與 missing[]（{camera_id, frame_index, timestamp_s, reason}）；每個 sample 必須正好出現在兩者其中一處（§2.3）",
      "validator": "依 v1.1；規則 RUN-004"
    },
    {
      "section": "§2.3 缺影格",
      "v1_0_2643771": "未區分",
      "v1_1_0e51c53": "pinned 檔案不存在是完整性錯誤（PINNED_RGB_RECORD_MISSING）；expected grid 缺漏是 RGB_INDEX_INCOMPLETE",
      "validator": "RUN-004 只檢查 index 本身；不開影像，故不檢查檔案存在"
    },
    {
      "section": "§3.12 track_height_estimate、§2.4 uncertainty",
      "v1_0_2643771": "無",
      "v1_1_0e51c53": "新增（RGB 推得輸出，Codex 主責）",
      "validator": "不屬 scene_static，不檢查"
    },
    {
      "section": "§3.1–§3.10",
      "v1_0_2643771": "—",
      "v1_1_0e51c53": "與 2643771 相同（逐行 diff 確認）",
      "validator": "—"
    }
  ],
  "id_rules": {
    "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
    "spec": "契約 §3.2",
    "prefix_by_class": {
      "WALKABLE": "WALK_",
      "OBSTACLE": "OBSTACLE_",
      "WALL": "WALL_",
      "PORTAL": "PORTAL_",
      "STAIR": "STAIR_",
      "ROOM": "ROOM_",
      "CORRIDOR": "CORR_",
      "AREA": "AREA_",
      "DISPLAY_ONLY": null
    },
    "prefix_other_records": {
      "cameras[].camera_id": "CAM_",
      "floors[].floor_id": "FLOOR_"
    },
    "stable_id_rules": [
      "ID 存在 Blender 物件的 custom property amidst_id，不靠顯示名稱",
      "幾何修改不換 ID，只遞增 geometry_version",
      "刪除的 ID 不得重用",
      "重複 ID 讓整份匯出無效",
      "跨檔案的 ID 引用必須存在，類型也必須相符"
    ],
    "naming_note": "walkable 的 WALK_CORR_W 與 corridor 物件 CORR_W 是不同 ID；牆保留 WALL_ 前綴，不混成 OBSTACLE_（設計稿 §1.2）"
  },
  "purpose_policy": {
    "spec": "契約 §3.3；設計稿 §5 預期物件表",
    "purposes": ["WALKABILITY", "OCCLUSION", "COLLISION", "VISIBILITY_INDEX", "DISPLAY"],
    "display_only_forbids": ["WALKABILITY", "OCCLUSION", "COLLISION"],
    "approval_initial": "NOT_EVALUATED（設計稿 §5：用途核准狀態先 NOT_EVALUATED，不能預填 APPROVED）",
    "by_class": {
      "WALKABLE": {
        "allowed": ["WALKABILITY", "DISPLAY"],
        "display_only": false
      },
      "PORTAL": {
        "allowed": ["WALKABILITY", "DISPLAY"],
        "display_only": false
      },
      "WALL": {
        "allowed": ["OCCLUSION", "COLLISION", "VISIBILITY_INDEX", "DISPLAY"],
        "display_only": false
      },
      "OBSTACLE": {
        "allowed": ["OCCLUSION", "COLLISION", "VISIBILITY_INDEX", "DISPLAY"],
        "display_only": false
      },
      "CORRIDOR": {
        "allowed": ["DISPLAY"],
        "display_only": true
      },
      "ROOM": {
        "allowed": ["DISPLAY"],
        "display_only": true
      },
      "AREA": {
        "allowed": ["DISPLAY"],
        "display_only": true
      }
    }
  },
