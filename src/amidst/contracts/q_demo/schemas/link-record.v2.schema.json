{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "q-demo.link-record.v2"
    },
    "session_id": {
      "type": "string"
    },
    "link_index": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "frame_ref": {
      "type": "string"
    },
    "local_segment_id": {
      "type": "string"
    },
    "prev_observation_id": {
      "type": "string"
    },
    "next_observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "iou": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "elapsed_us": {
      "type": "integer",
      "minimum": 1
    },
    "gap_samples": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "LINKED",
        "NO_CANDIDATE",
        "AMBIGUOUS_LINK",
        "FRAME_NOT_INFERRED",
        "FRAME_MISSING"
      ]
    },
    "ambiguous_candidates": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observation_id": {
                "type": "string"
              },
              "iou": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "observation_id",
              "iou"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      ]
    },
    "matching_audit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "enum": [
                "LAST_OBSERVATION_V1",
                "CENTER_TRANSLATION_V1"
              ]
            },
            "reference_bbox_xyxy_px": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "source_observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "observation_id": {
                    "type": "string"
                  },
                  "timestamp_us": {
                    "type": "integer"
                  },
                  "bbox_xyxy_px": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "observation_id",
                  "timestamp_us",
                  "bbox_xyxy_px"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 2
            },
            "elapsed_us": {
              "type": "integer",
              "minimum": 1
            },
            "actual_pair_iou": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "reference_iou": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "event": {
              "enum": [
                "REACQUIRED",
                "LINKED",
                "NO_MATCH"
              ]
            },
            "identity_verdict": {
              "const": "UNCONFIRMED"
            }
          },
          "required": [
            "method",
            "reference_bbox_xyxy_px",
            "source_observations",
            "elapsed_us",
            "actual_pair_iou",
            "reference_iou",
            "event",
            "identity_verdict"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "link_index",
    "run_id",
    "camera_id",
    "frame_ref",
    "local_segment_id",
    "prev_observation_id",
    "next_observation_id",
    "iou",
    "elapsed_us",
    "gap_samples",
    "decision",
    "ambiguous_candidates",
    "matching_audit"
  ],
  "additionalProperties": false,
  "x-contract-ref": "§8.2 (D69, #135 C3), D78 matching_audit (link-record.v2); v1 only replays old recordings"
}
