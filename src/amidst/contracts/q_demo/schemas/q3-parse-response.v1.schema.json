{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "q-demo.q3-parse-response.v1"
    },
    "status": {
      "enum": [
        "PARSED",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED_CLASS",
        "UNSUPPORTED_CONDITION",
        "PARSE_FAILED",
        "TIME_EXPRESSION_INVALID"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_scope": {
      "$ref": "common.schema.json#/$defs/resolved_scope"
    },
    "identity_verdict": {
      "$ref": "common.schema.json#/$defs/identity_verdict"
    },
    "llm_parse_used": {
      "type": "boolean"
    },
    "agent_attempted": {
      "type": "boolean"
    },
    "agent_used": {
      "type": "boolean"
    },
    "decision_source": {
      "$ref": "common.schema.json#/$defs/decision_source"
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_reason": {
      "$ref": "common.schema.json#/$defs/fallback_reason"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "stats": {
      "$ref": "common.schema.json#/$defs/stats"
    },
    "output_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "parsed_by": {
      "anyOf": [
        {
          "enum": [
            "LLM",
            "RULE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "structured_query": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "question",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "llm_call": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "model_digest": {
              "type": "string"
            },
            "prompt_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "prompt_ref": {
              "type": "string"
            },
            "raw_output_sha256": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "validation_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "model",
            "model_digest",
            "prompt_sha256",
            "prompt_ref",
            "raw_output_sha256",
            "attempts",
            "validation_errors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "reason",
    "resolved_scope",
    "identity_verdict",
    "llm_parse_used",
    "agent_attempted",
    "agent_used",
    "decision_source",
    "fallback_used",
    "fallback_reason",
    "provenance",
    "output_sha256",
    "parsed_by",
    "structured_query",
    "unresolved_terms",
    "clarification",
    "llm_call"
  ],
  "additionalProperties": false,
  "x-contract-ref": "§7.4"
}
