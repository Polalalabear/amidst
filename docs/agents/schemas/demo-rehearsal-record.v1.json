{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "demo-rehearsal-record.v1"
    },
    "checklist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixture_role": {
      "const": "SYNTHETIC_ONLY"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[BCD]-[0-9]{2}$"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "SCREENSHOT",
                    "OUTPUT"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "claude_review_status": {
            "type": "string",
            "enum": [
              "NOT_REVIEWED",
              "REVIEWED"
            ],
            "default": "NOT_REVIEWED"
          }
        },
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "fallback": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "SCREENSHOT",
                    "OUTPUT"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "claude_review_status": {
            "type": "string",
            "enum": [
              "NOT_REVIEWED",
              "REVIEWED"
            ],
            "default": "NOT_REVIEWED"
          }
        },
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "checklist_sha256",
    "items",
    "fallback"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "CQ-42-T record-format proposal; never evidence of #346 human acceptance."
}
