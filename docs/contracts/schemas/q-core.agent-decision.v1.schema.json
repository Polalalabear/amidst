{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "q-core.agent-decision.v1",
  "title": "q-core Agent decision request/response/record v1",
  "description": "v1 contract for the bounded Agent decisions DP1 (handoff adjudication) and DP3 (continuation acceptance). Design source: docs/design/AGENT_DECISION_V1.md §2. Validator: src/amidst/q1q5/agent_decision.py (the repository has no jsonschema dependency; tests/q1q5/test_agent_decision_wp1.py checks that the validator and this file agree). A request carries only numeric summaries and opaque ids: no Ground Truth, script, visibility, depth, renderer path, actor id, file path or raw track ref. identity_verdict is always UNCONFIRMED. decision_source/fallback_reason reuse src/amidst/contracts/q_demo/schemas/common.v2.schema.json; CALL_BUDGET_EXHAUSTED and REPLAY_MISS were added to common.v2 additively under D168 (design §8.2 Q3; Codex informed, no confirmation needed).",
  "status": "V1",
  "added_to_common_v2": {
    "fallback_reason": ["CALL_BUDGET_EXHAUSTED", "REPLAY_MISS"],
    "decision": "D168",
    "question": "docs/design/AGENT_DECISION_V1.md §8.2 Q3"
  },
  "$defs": {
    "opaque_id": {
      "description": "Candidate ids are renumbered by the request builder (A1, B2, ...); the mapping never enters the request.",
      "type": "string",
      "pattern": "^[A-Z]{1,2}[0-9]{1,3}$"
    },
    "camera_id": {
      "type": "string",
      "pattern": "^CAM_[A-Z0-9_]{1,40}$"
    },
    "color": {
      "enum": ["red", "orange", "yellow", "green", "blue", "purple"]
    },
    "us": {
      "type": "integer",
      "minimum": 0
    },
    "decision_point": {
      "enum": ["DP1_HANDOFF_ADJUDICATION", "DP3_CONTINUATION_ACCEPTANCE"]
    },
    "mode": {
      "description": "OFF is the default and leaves associate() untouched. RULE_ONLY runs the decider wrapper with the rule only. AGENT_LIVE calls a provider; AGENT_REPLAY reads a recording by request_sha256 and never uses the network.",
      "enum": ["OFF", "RULE_ONLY", "AGENT_LIVE", "AGENT_REPLAY"],
      "default": "OFF"
    },
    "answer": {
      "description": "DP1: a candidate opaque id or ABSTAIN. DP3: ACCEPT_SEGMENT or REJECT_SEGMENT.",
      "type": "string",
      "pattern": "^(?:[A-Z]{1,2}[0-9]{1,3}|ABSTAIN|ACCEPT_SEGMENT|REJECT_SEGMENT)$"
    },
    "identity_verdict": {
      "const": "UNCONFIRMED"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "min", "median", "max"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "min": {"type": "number", "minimum": 0, "maximum": 1},
        "median": {"type": "number", "minimum": 0, "maximum": 1},
        "max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "track_view": {
      "type": "object",
      "required": ["id", "camera_id", "first_seen_us", "last_seen_us", "colors", "scores", "continuation_fraction"],
      "properties": {
        "id": {"$ref": "#/$defs/opaque_id"},
        "camera_id": {"$ref": "#/$defs/camera_id"},
        "first_seen_us": {"$ref": "#/$defs/us"},
        "last_seen_us": {"$ref": "#/$defs/us"},
        "colors": {
          "type": "array",
          "items": {"$ref": "#/$defs/color"},
          "uniqueItems": true,
          "maxItems": 6
        },
        "scores": {"$ref": "#/$defs/score_summary"},
        "continuation_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "handoff_candidate": {
      "description": "rule_eligible=false rows (colour-incompatible but time-legal, design §2.5) are context only and cannot be selected.",
      "allOf": [{"$ref": "#/$defs/track_view"}],
      "type": "object",
      "required": ["gap_us", "graph_edge", "link_kind", "rule_eligible"],
      "properties": {
        "gap_us": {"type": "integer", "minimum": 0},
        "graph_edge": {"type": "boolean"},
        "link_kind": {
          "enum": ["SAME_CAMERA_REACQUISITION", "CROSS_CAMERA_HANDOFF", "CROSS_CAMERA_REACQUISITION"]
        },
        "rule_eligible": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "decision_point", "as_of_us", "topology", "current", "rule_answer", "identity_verdict"],
      "properties": {
        "schema_version": {"const": "q-core.agent-decision-request.v1"},
        "decision_point": {"$ref": "#/$defs/decision_point"},
        "as_of_us": {"$ref": "#/$defs/us"},
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph_status", "edges"],
          "properties": {
            "graph_status": {"enum": ["GRAPH_NOT_APPROVED", "GRAPH_APPROVED"]},
            "edges": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "array",
                "prefixItems": [{"$ref": "#/$defs/camera_id"}, {"$ref": "#/$defs/camera_id"}],
                "items": false,
                "minItems": 2
              }
            }
          }
        },
        "current": {"$ref": "#/$defs/track_view", "unevaluatedProperties": false},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/handoff_candidate"}
        },
        "segment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_us", "end_us", "n_frames", "box_scores"],
          "properties": {
            "start_us": {"$ref": "#/$defs/us"},
            "end_us": {"$ref": "#/$defs/us"},
            "n_frames": {"type": "integer", "minimum": 1},
            "box_scores": {"$ref": "#/$defs/score_summary"}
          }
        },
        "rule_answer": {"$ref": "#/$defs/answer"},
        "identity_verdict": {"$ref": "#/$defs/identity_verdict"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision_point": {"const": "DP1_HANDOFF_ADJUDICATION"}}},
          "then": {"required": ["candidates"], "not": {"required": ["segment"]}}
        },
        {
          "if": {"properties": {"decision_point": {"const": "DP3_CONTINUATION_ACCEPTANCE"}}},
          "then": {"required": ["segment"], "not": {"required": ["candidates"]}}
        }
      ]
    },
    "response": {
      "description": "What the model must return: a candidate id or ABSTAIN (DP1), ACCEPT/REJECT (DP3), plus reason codes and a short rationale. Anything else is INVALID_RESPONSE; a candidate id that is not in the request or has rule_eligible=false is ILLEGAL_CANDIDATE. Either way the rule answer is used.",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason_codes", "rationale"],
      "properties": {
        "action": {"enum": ["SELECT", "ABSTAIN", "ACCEPT_SEGMENT", "REJECT_SEGMENT"]},
        "candidate_id": {"$ref": "#/$defs/opaque_id"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COLOR_MATCH", "COLOR_CONFLICT", "GRAPH_EDGE", "NO_GRAPH_EDGE", "SHORT_GAP", "LONG_GAP",
              "HIGH_SCORE", "LOW_SCORE", "MOSTLY_CONTINUATION", "INSUFFICIENT_EVIDENCE"
            ]
          }
        },
        "rationale": {"type": "string", "maxLength": 240}
      },
      "if": {"properties": {"action": {"const": "SELECT"}}},
      "then": {"required": ["candidate_id"]},
      "else": {"not": {"required": ["candidate_id"]}}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_sha256", "decision_point", "mode", "decision_source", "fallback_reason",
        "budget_layer", "final_answer", "rule_answer", "identity_verdict", "provider", "parameter_set_sha256",
        "attempts"
      ],
      "properties": {
        "schema_version": {"const": "q-core.agent-decision-record.v1"},
        "request_sha256": {
          "description": "SHA-256 of the canonical request with candidates sorted by id (design §3.3), so K reruns with different candidate orders map to one question.",
          "$ref": "#/$defs/sha256"
        },
        "decision_point": {"$ref": "#/$defs/decision_point"},
        "mode": {"$ref": "#/$defs/mode"},
        "decision_source": {"enum": ["AGENT", "RULE_FALLBACK", "RULE_ONLY"]},
        "fallback_reason": {
          "enum": [
            "ROUND_LIMIT", "TIME_BUDGET", "PROVIDER_UNAVAILABLE", "PROVIDER_TIMEOUT", "INVALID_RESPONSE",
            "ILLEGAL_CANDIDATE", "MODE_NOT_AUTHORIZED", "CALL_BUDGET_EXHAUSTED", "REPLAY_MISS", null
          ]
        },
        "budget_layer": {
          "description": "Which cap was exhausted when fallback_reason is CALL_BUDGET_EXHAUSTED; null otherwise.",
          "enum": ["SESSION_ROUNDS", "MODEL_CALLS", "MODEL_TOKENS", "STAGE_CALLS", "STAGE_TOKENS", "TOTAL_USD", null]
        },
        "final_answer": {"$ref": "#/$defs/answer"},
        "rule_answer": {"$ref": "#/$defs/answer"},
        "identity_verdict": {"$ref": "#/$defs/identity_verdict"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "model"],
          "properties": {
            "kind": {"enum": ["NONE", "OPENAI", "OLLAMA_LOOPBACK"]},
            "model": {
              "description": "Parameter-set model id (astra6, sol6.1, terra6.1) or null for rule-only records.",
              "type": ["string", "null"]
            },
            "api_model_id": {
              "description": "Exact model id returned by the API, recorded on the day of the run.",
              "type": ["string", "null"]
            },
            "model_digest": {"type": ["string", "null"]},
            "temperature": {"type": ["number", "null"]},
            "seed": {"type": ["integer", "null"]},
            "candidate_order_seed": {"type": ["integer", "null"]}
          }
        },
        "parameter_set_sha256": {"$ref": "#/$defs/sha256"},
        "attempts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wall_ms", "timeout_ms", "outcome"],
            "properties": {
              "wall_ms": {"type": "number", "minimum": 0},
              "timeout_ms": {"type": "integer", "minimum": 1},
              "outcome": {
                "enum": [
                  "OK", "PROVIDER_TIMEOUT", "PROVIDER_UNAVAILABLE", "PROVIDER_RETRYABLE_ERROR",
                  "INVALID_RESPONSE", "ILLEGAL_CANDIDATE", "REPLAY_MISS"
                ]
              },
              "response_sha256": {"type": ["string", "null"]},
              "prompt_tokens": {"type": ["integer", "null"]},
              "completion_tokens": {"type": ["integer", "null"]}
            }
          }
        }
      }
    }
  }
}
