{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "q-core.agent-decision.v1.draft",
  "title": "DRAFT q-core Agent decision request/response/record v1",
  "description": "DRAFT — not approved. Design source: docs/design/AGENT_DECISION_V1.md §2. Enum values for decision_source and fallback_reason are reused from src/amidst/contracts/q_demo/schemas/common.v2.schema.json; new values are marked in the design doc. No GT, script, visibility, depth, renderer trajectory, actor id or file path may appear in a request.",
  "status": "DRAFT",
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}[0-9]{1,3}$"
    },
    "camera_id": {
      "type": "string",
      "pattern": "^CAM_[A-Z0-9_]{1,40}$"
    },
    "color": {
      "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple"
      ]
    },
    "us": {
      "type": "integer",
      "minimum": 0
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "min",
        "median",
        "max"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "median": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "track_view": {
      "type": "object",
      "required": [
        "id",
        "camera_id",
        "first_seen_us",
        "last_seen_us",
        "colors",
        "scores",
        "continuation_fraction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaque_id"
        },
        "camera_id": {
          "$ref": "#/$defs/camera_id"
        },
        "first_seen_us": {
          "$ref": "#/$defs/us"
        },
        "last_seen_us": {
          "$ref": "#/$defs/us"
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "scores": {
          "$ref": "#/$defs/score_summary"
        },
        "continuation_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "handoff_candidate": {
      "allOf": [
        {
          "$ref": "#/$defs/track_view"
        }
      ],
      "type": "object",
      "required": [
        "gap_us",
        "graph_edge",
        "link_kind"
      ],
      "properties": {
        "gap_us": {
          "type": "integer"
        },
        "graph_edge": {
          "type": "boolean"
        },
        "link_kind": {
          "enum": [
            "SAME_CAMERA_REACQUISITION",
            "CROSS_CAMERA_HANDOFF",
            "CROSS_CAMERA_REACQUISITION"
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_point",
        "as_of_us",
        "topology",
        "current",
        "candidates",
        "rule_answer",
        "identity_verdict"
      ],
      "properties": {
        "schema_version": {
          "const": "q-core.agent-decision-request.v1"
        },
        "decision_point": {
          "enum": [
            "DP1_HANDOFF_ADJUDICATION",
            "DP3_CONTINUATION_ACCEPTANCE"
          ]
        },
        "as_of_us": {
          "$ref": "#/$defs/us"
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graph_status",
            "edges"
          ],
          "properties": {
            "graph_status": {
              "enum": [
                "GRAPH_NOT_APPROVED",
                "GRAPH_APPROVED"
              ]
            },
            "edges": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "#/$defs/camera_id"
                  },
                  {
                    "$ref": "#/$defs/camera_id"
                  }
                ],
                "items": false,
                "minItems": 2
              }
            }
          }
        },
        "current": {
          "$ref": "#/$defs/track_view",
          "unevaluatedProperties": false
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/handoff_candidate"
          }
        },
        "segment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_us",
            "end_us",
            "n_frames",
            "box_scores"
          ],
          "properties": {
            "start_us": {
              "$ref": "#/$defs/us"
            },
            "end_us": {
              "$ref": "#/$defs/us"
            },
            "n_frames": {
              "type": "integer",
              "minimum": 1
            },
            "box_scores": {
              "$ref": "#/$defs/score_summary"
            }
          }
        },
        "rule_answer": {
          "type": "string"
        },
        "identity_verdict": {
          "const": "UNCONFIRMED"
        }
      }
    },
    "response": {
      "description": "What the model must return. Anything else, or a candidate id not in the request, is INVALID_RESPONSE / ILLEGAL_CANDIDATE and the rule answer is used.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason_codes",
        "rationale"
      ],
      "properties": {
        "action": {
          "enum": [
            "SELECT",
            "ABSTAIN",
            "ACCEPT_SEGMENT",
            "REJECT_SEGMENT"
          ]
        },
        "candidate_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COLOR_MATCH",
              "COLOR_CONFLICT",
              "GRAPH_EDGE",
              "NO_GRAPH_EDGE",
              "SHORT_GAP",
              "LONG_GAP",
              "HIGH_SCORE",
              "LOW_SCORE",
              "MOSTLY_CONTINUATION",
              "INSUFFICIENT_EVIDENCE"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_sha256",
        "decision_point",
        "decision_source",
        "final_answer",
        "rule_answer",
        "identity_verdict",
        "provider",
        "attempts"
      ],
      "properties": {
        "schema_version": {
          "const": "q-core.agent-decision-record.v1"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_point": {
          "enum": [
            "DP1_HANDOFF_ADJUDICATION",
            "DP3_CONTINUATION_ACCEPTANCE"
          ]
        },
        "decision_source": {
          "enum": [
            "AGENT",
            "RULE_FALLBACK",
            "RULE_ONLY"
          ]
        },
        "fallback_reason": {
          "enum": [
            "ROUND_LIMIT",
            "TIME_BUDGET",
            "PROVIDER_UNAVAILABLE",
            "PROVIDER_TIMEOUT",
            "INVALID_RESPONSE",
            "ILLEGAL_CANDIDATE",
            "MODE_NOT_AUTHORIZED",
            "CALL_BUDGET_EXHAUSTED",
            "REPLAY_MISS",
            null
          ]
        },
        "final_answer": {
          "type": "string"
        },
        "rule_answer": {
          "type": "string"
        },
        "identity_verdict": {
          "const": "UNCONFIRMED"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "mode"
          ],
          "properties": {
            "kind": {
              "enum": [
                "NONE",
                "OPENAI",
                "OLLAMA_LOOPBACK"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "enum": [
                "RULE_ONLY",
                "LIVE",
                "REPLAY"
              ]
            },
            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "candidate_order_seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "attempts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wall_ms",
              "outcome"
            ],
            "properties": {
              "wall_ms": {
                "type": "number",
                "minimum": 0
              },
              "outcome": {
                "enum": [
                  "OK",
                  "PROVIDER_TIMEOUT",
                  "PROVIDER_UNAVAILABLE",
                  "INVALID_RESPONSE",
                  "ILLEGAL_CANDIDATE"
                ]
              },
              "response_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prompt_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "completion_tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
