{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "q-demo.api-bootstrap.v1.schema.json",
  "title": "Additive bootstrap run statistics contract",
  "description": "Derived indexed-detection display statistics; not part of any content hash. Existing bootstrap fields remain extensible. Cross-field set/count/pin consistency is verified by pytest.",
  "type": "object",
  "required": [
    "schema_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "q-demo.api-bootstrap.v1"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "detection_index_sha256",
          "detected_class_counts"
        ],
        "properties": {
          "detection_index_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "detected_class_counts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/detectedClassCount"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "detectedClassCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_label",
        "detection_count",
        "camera_count",
        "camera_ids"
      ],
      "properties": {
        "class_label": {
          "type": "string",
          "minLength": 1
        },
        "detection_count": {
          "type": "integer",
          "minimum": 1
        },
        "camera_count": {
          "type": "integer",
          "minimum": 1
        },
        "camera_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
